NODE_ENV=development
PORT=8080

DATABASE_URL=postgres://postgres:postgres@db:5432/studymatcher

JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins; example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173

MAIL_FROM_NAME=Study Matcher
MAIL_FROM_EMAIL=yourgmail@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password

APP_BASE_URL=http://localhost:5173

REMINDERS_ENABLED=true
REMINDER_WINDOW_MINUTES=60
